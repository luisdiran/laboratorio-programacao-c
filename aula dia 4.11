   ============1========
#include <stdio.h>

void exibirMenu(void) {
    printf("\n CALCULADORA \n\n");
    printf("1 - Somar\n");
    printf("2 - Subtrair\n");
    printf("3 - Multiplicar\n");
    printf("4 - Dividir\n");
    printf("0 - Sair\n\n");
    printf("Escolha uma opcao: ");}

float somar(float a, float b) {
    return a + b;}

float subtrair(float a, float b) {
    return a - b;}

float multiplicar(float a, float b) {
    return a * b;}

float dividir(float a, float b) {
    return a / b;}

int main(void) {
    int opcao;
    float n1, n2, resultado;

    do {
        exibirMenu();
        scanf("%d", &opcao);

        if (opcao >= 1 && opcao <= 4) {
            printf("\nPrimeiro numero: ");
            scanf("%f", &n1);
            printf("Segundo numero: ");
            scanf("%f", &n2);

            switch (opcao) {
                case 1:
                    resultado = somar(n1, n2);
                    printf("\nResultado: %.2f\n", resultado);
                    break;
                case 2:
                    resultado = subtrair(n1, n2);
                    printf("\nResultado: %.2f\n", resultado);
                    break;
                case 3:
                    resultado = multiplicar(n1, n2);
                    printf("\nResultado: %.2f\n", resultado);
                    break;
                case 4:
                    if (n2 == 0) {
                        printf("\nErro: Divisao por zero nao e permitida!\n");
                        
                    } else {
                        resultado = dividir(n1, n2);
                        printf("\nResultado: %.2f\n", resultado);}
                    break;
            }
        } else if (opcao != 0) {
            printf("\nOpcao invalida! Tente novamente.\n");
            
        }
        
    } while (opcao != 0);

    return 0;}

    ===========2===========
  
#include <stdio.h>

float maiorPreco(float p1, float p2) {
    if (p1 > p2) {
        return p1;
    } else {
        return p2;
    }
}

int main(void) {
    float preco1, preco2;

    printf(" COMPARADOR DE PRECOS \n\n");
    printf("Preco 1: ");
    scanf("%f", &preco1);
    printf("Preco 2: ");
    scanf("%f", &preco2);

    printf("\n");

    if (preco1 == preco2) {
        printf("Os dois precos sao iguais (R$ %.2f).\n", preco1);
    } else {
        float maior = maiorPreco(preco1, preco2);
        printf("Maior preco: R$ %.2f\n", maior);
    }

    return 0;}

      ============3===========

      #include <stdio.h>

int verificarPar(int num) {
    if (num % 2 == 0) {
        return 1;
    } else {
        return 0;
    }
}

int main(void) {
    int numero;

    printf(" VERIFICADOR DE NUMEROS \n\n");
    printf("Digite um numero: ");
    scanf("%d", &numero);

    if (verificarPar(numero) == 1) {
        printf("O numero %d e par.\n", numero);
    } else {
        printf("O numero %d e impar.\n", numero);
    }

    return 0;
}

    ============4==========

    #include <stdio.h>

int dobro(int qtd) {
    return qtd * 2;
}

int main(void) {
    int qtdInicial, qtdFinal;

    printf(" CONTROLE DE ESTOQUE \n\n");
    printf("Quantidade inicial: ");
    scanf("%d", &qtdInicial);

    qtdFinal = dobro(qtdInicial);

    printf("Quantidade apos duplicacao: %d\n", qtdFinal);

    return 0;
}

