int main(void) {
    
    int n1, n2, n3, n4;
    
    printf("Digite 4 números: ");
    scanf("%d %d %d %d", &n1, &n2, &n3, &n4);
    
    int numeros[2][2] = {
        {n1, n2},
        {n3, n4}
    };
     for(int i = 0; i < 2; i++) {
