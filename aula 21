#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main() {
    FILE *arquivo;
    char nome[100];
    int matricula;
    int qtd;

    printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
    scanf("%d", &qtd);
    getchar(); 

    if (qtd < 1 || qtd > 5) {
        printf("Quantidade invalida! O limite e de 1 a 5 funcionarios.\n");
        return 1;
    }

    arquivo = fopen("funcionarios.txt", "w");
    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo!\n");
        return 1;
    }

    for (int i = 0; i < qtd; i++) {
        printf("\n--- Funcionario %d ---\n", i + 1);
        printf("Nome: ");
        fgets(nome, sizeof(nome), stdin);
        nome[strcspn(nome, "\n")] = '\0'; 

        printf("Matricula: ");
        scanf("%d", &matricula);
        getchar(); 

        fprintf(arquivo, "Nome: %s | Matricula: %d\n", nome, matricula);
    }

    fclose(arquivo);
    printf("\nDados gravados com sucesso em funcionarios.txt!\n");

    return 0;
}

