#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

int main() {
    FILE *arquivo;
    Funcionario lista[5];
    int qtd;
    char linha[150];

    printf("Quantos funcionarios deseja cadastrar agora (1 a 5)? ");
    scanf("%d", &qtd);
    getchar(); // Limpa o buffer

    if (qtd < 1 || qtd > 5) {
        printf("Quantidade invalida! Informe um valor entre 1 e 5.\n");
        return 1;
    }

  
    arquivo = fopen("funcionarios.txt", "a");
    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo!\n");
        return 1;
    }

    for (int i = 0; i < qtd; i++) {
        printf("\n--- Cadastro %d ---\n", i + 1);
        printf("Nome: ");
        fgets(lista[i].nome, sizeof(lista[i].nome), stdin);
        lista[i].nome[strcspn(lista[i].nome, "\n")] = '\0';

        printf("Salario: R$ ");
        scanf("%f", &lista[i].salario);

        printf("Horas Extras: ");
        scanf("%d", &lista[i].horasExtras);
        getchar(); // Limpa o buffer

        fprintf(arquivo, "Nome: %s | Salario: R$ %.2f | Horas Extras: %d\n",
                lista[i].nome, lista[i].salario, lista[i].horasExtras);
    }

    fclose(arquivo);
    printf("\nRegistros adicionados com sucesso!\n");

  
    arquivo = fopen("funcionarios.txt", "r");
    if (arquivo == NULL) {
        printf("Erro ao abrir o arquivo para leitura!\n");
        return 1;
    }

    printf("\n=== TODOS OS FUNCIONARIOS CADASTRADOS ===\n");
    while (fgets(linha, sizeof(linha), arquivo) != NULL) {
        printf("%s", linha);
    }

    fclose(arquivo);

    return 0;
}

