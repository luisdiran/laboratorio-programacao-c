#include <stdio.h>
#include <string.h>

int main(void) {
    char nome_produto[50];
    char categoria_input[30];
    char categoria_formatada[30];
    char produto_copia[50];
    char descricao[100] = "Produto: ";

    printf("===== CADASTRO DE PRODUTOS =====\n\n");
    printf("Nome do produto: ");
    scanf("%49s", nome_produto);

    printf("Categoria: ");
    scanf("%29s", categoria_input);

  
    size_t qtd_caracteres = strlen(nome_produto);

    if (strcmp(categoria_input, "HARDWARE") == 0) {
        strcpy(categoria_formatada, "Hardware");
    } else if (strcmp(categoria_input, "PERIFERICO") == 0) {
        strcpy(categoria_formatada, "Periferico");
    } else {
        strcpy(categoria_formatada, "Outro");
    }

    
    strcpy(produto_copia, nome_produto);


    strcat(descricao, produto_copia);

  
    printf("\n===== RESUMO =====\n");
    printf("Produto: %s\n", produto_copia);
    printf("Caracteres: %zu\n", qtd_caracteres);
    printf("Categoria: %s\n\n", categoria_formatada);
    printf("Descricao: %s\n", descricao);
    printf("Cadastro concluido!\n");

    return 0;}


