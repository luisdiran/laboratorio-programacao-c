#include <stdio.h>
#include <string.h>

int main(void) {
    char nome[50];
    char perfil_input[20];
    char perfil_formatado[30];
    char nome_confirmacao[50];
    char mensagem_boas_vindas[100] = "Bem-vindo(a), ";

    printf("===== CADASTRO DE USUARIOS =====\n\n");
    printf("Digite seu nome: ");
    scanf("%49s", nome);

    printf("Digite seu perfil: ");
    scanf("%19s", perfil_input);

   
    size_t qtd_caracteres = strlen(nome);

    
    if (strcmp(perfil_input, "ADMIN") == 0) {
        strcpy(perfil_formatado, "Administrador");
    } else if (strcmp(perfil_input, "COMUM") == 0) {
        strcpy(perfil_formatado, "Comum");
    } else {
        strcpy(perfil_formatado, "Perfil Indefinido");
    }

   
    strcpy(nome_confirmacao, nome);

   
    strcat(mensagem_boas_vindas, nome_confirmacao);
    strcat(mensagem_boas_vindas, "!");

  
    printf("\n===== DADOS CADASTRADOS =====\n");
    printf("Nome: %s\n", nome_confirmacao);
    printf("Quantidade de caracteres: %zu\n", qtd_caracteres);
    printf("Perfil: %s\n\n", perfil_formatado);
    printf("%s\n", mensagem_boas_vindas);
    printf("Cadastro realizado com sucesso.\n");

    return 0;}


