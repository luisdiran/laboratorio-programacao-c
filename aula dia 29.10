#include <stdio.h>
#include <string.h>

int main(void) {
    char nome_estudante[50];
    char codigo_curso[10];
    char nome_curso[50];
    char nome_copia[50];
    char mensagem_ola[100] = "Ola, ";

    printf("===== IDENTIFICACAO ACADEMICA =====\n\n");
    printf("Nome do estudante: ");
    scanf("%49s", nome_estudante);

    printf("Codigo do curso: ");
    scanf("%9s", codigo_curso);

    if (strcmp(codigo_curso, "CC") == 0) {
        strcpy(nome_curso, "Ciencia da Computacao");
    } else if (strcmp(codigo_curso, "SI") == 0) {
        strcpy(nome_curso, "Sistemas de Informacao");
    } else {
        strcpy(nome_curso, "Curso Nao Encontrado");
    }

   
    size_t qtd_caracteres = strlen(nome_estudante);

   
    strcpy(nome_copia, nome_estudante);


    strcat(mensagem_ola, nome_copia);
    strcat(mensagem_ola, "!");


    printf("\n===== RESULTADO =====\n");
    printf("Estudante: %s\n", nome_copia);
    printf("Curso: %s\n", nome_curso);
    printf("Caracteres no nome: %zu\n\n", qtd_caracteres);
    printf("%s\n", mensagem_ola);

    return 0;}
