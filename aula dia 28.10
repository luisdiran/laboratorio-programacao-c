Desafio – Contador de caracteres:


#include <stdio.h>

int main(void) {
    char palavra[100];
    int contador = 0;

    printf("Digite uma palavra: ");
    scanf("%99s", palavra);
    
    for (int i = 0; palavra[i] != '\0'; i++) {
        contador++;
    }

    printf("A palavra '%s' possui %d caracteres.\n", palavra, contador);

    return 0;}
